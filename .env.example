# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Supabase Anonymous / Publishable Key (safe to use in frontend code with RLS)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon / public)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# NOTE: NEVER EXPOSE the service_role secret key in frontend code or with the VITE_ prefix!
# All public access is strictly secured via Row Level Security (RLS) policies.
